<?xml version="1.0" encoding="utf-8"?>
<!-- v0.48: salin ke android/app/src/main/res/xml/data_extraction_rules.xml.
     Data SiSi (SQLite, foto, arsip, token) tidak ikut cadangan Google maupun pindah HP (Android 12+). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
